# Android emulator default: http://10.0.2.2:8000/api/v1
# Physical device: use the development computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1

# Future Google authentication public client IDs (currently disabled)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Future external realtime provider placeholders (current socket remains unchanged)
EXPO_PUBLIC_REALTIME_SERVER_URL=
EXPO_PUBLIC_REALTIME_PUBLIC_KEY=

# GIPHY requests are proxied through the API; do not put a secret key in Expo source.
