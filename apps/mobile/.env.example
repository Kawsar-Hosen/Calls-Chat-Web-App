# Production API (Railway). Physical devices reach it over the internet.
# Local dev: emulator => http://10.0.2.2:8000/api/v1 ; LAN device => http://<computer-lan-ip>:8000/api/v1
EXPO_PUBLIC_API_URL=https://api-production-15d6.up.railway.app/api/v1

# Google sign-in (OAuth client IDs from Google Cloud Console)
# GOOGLE_CLIENT_ID is the "Web application" client ID (used in Expo Go via the auth.expo.io proxy).
# Android/iOS client IDs are optional extras for standalone builds.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Future external realtime provider placeholders (current socket remains unchanged)
EXPO_PUBLIC_REALTIME_SERVER_URL=
EXPO_PUBLIC_REALTIME_PUBLIC_KEY=

# GIPHY requests are proxied through the API; do not put a secret key in Expo source.
