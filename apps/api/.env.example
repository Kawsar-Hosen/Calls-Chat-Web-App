DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xyteee
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Cloudflare R2 (STORAGE_BACKEND=r2) - S3-compatible API
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=xyteee-storage
STORAGE_ACCESS_KEY=<R2-access-key-id>
STORAGE_SECRET_KEY=<R2-secret-access-key>
STORAGE_PUBLIC_URL=https://cdn.xyteee.com
STORAGE_REGION=auto
# Cloudflare Calls TURN (WebRTC) - see app/turn.py
TURN_KEY_ID=
TURN_API_TOKEN=
# Firebase Cloud Messaging (push). FCM_PROJECT_ID is public.
# Either FCM_CREDENTIALS_JSON (full service-account JSON; use on Railway/CI where env vars are native)
# or FCM_CREDENTIALS_FILE (path to the downloaded service-account JSON; easiest locally).
# The service-account private key is a server-side secret - never commit it.
FCM_PROJECT_ID=xyteee-b0b95
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_FILE=
GIPHY_API_KEY=
# Email verification for account deletion (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=XYTEEE <your-account@gmail.com>
# Google sign-in (OAuth). GOOGLE_CLIENT_ID (Web application) is required.
# android/ios client IDs are used to accept ID tokens minted for native app clients.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
